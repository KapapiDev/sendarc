---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { buildCanonical, SITE_DESCRIPTION, SITE_NAME } from "../lib/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string | null;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | null;
  pageEvent?: "landing_view" | "affixa_view";
}

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  path = Astro.url.pathname,
  image = "/logo.svg",
  noindex = false,
  structuredData = null,
  pageEvent,
} = Astro.props;

const fullTitle = title === SITE_NAME ? SITE_NAME : `${title} — ${SITE_NAME}`;
const canonical = buildCanonical(Astro.site, path);
const socialImage = image ? buildCanonical(Astro.site, image) : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content="SendArc connects legacy Windows email actions to Gmail" />}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{fullTitle}</title>
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body data-page-event={pageEvent}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
