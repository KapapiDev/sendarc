---
import BetaForm from "../components/BetaForm.astro";
import DownloadLink from "../components/DownloadLink.astro";
import Faq from "../components/Faq.astro";
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { KAPAPI_URL, SITE_DESCRIPTION } from "../lib/site";

const faqItems = [
  {
    question: "What is SendArc?",
    answer:
      "SendArc is a small Windows utility that receives Simple MAPI email actions from compatible desktop software, shows a local preview, and sends the confirmed message through Gmail.",
  },
  {
    question: "Do I need to replace Gmail?",
    answer:
      "No. SendArc uses the Gmail or Google Workspace account you connect. It does not replace Gmail and it does not operate an email relay server.",
  },
  {
    question: "Do I need Thunderbird or Outlook?",
    answer:
      "No desktop mail client is required for SendArc's supported Gmail flow. Your existing Windows application starts the message, and SendArc handles preview and sending.",
  },
  {
    question: "What Windows applications work?",
    answer:
      "SendArc targets applications that call the Windows Simple MAPI send function. Compatibility varies by application and architecture, so the public beta documents only tested workflows and invites sanitized compatibility reports.",
  },
  {
    question: "Does SendArc read my inbox?",
    answer:
      "No. The beta requests no mailbox-read permission. Pending message data stays on your Windows device until you send or discard it.",
  },
  {
    question: "What Gmail permissions does SendArc request?",
    answer:
      "The beta requests only gmail.send, the narrow Gmail permission needed to send a message after you confirm the local preview.",
  },
  {
    question: "Is SendArc affiliated with Affixa?",
    answer:
      "No. SendArc is an independent open-source project and is not affiliated with Affixa or Notably Good Ltd.",
  },
  {
    question: "Is SendArc open source?",
    answer:
      "Yes. SendArc is derived from go-mapi and publishes its corresponding source under LGPL-3.0-or-later, with upstream and third-party notices preserved.",
  },
  {
    question: "What does Business Beta cost?",
    answer:
      "The planned signal price is $29 per seat per year. There is no charge today; the form only records interest and workflow needs.",
  },
  {
    question: "What happens if SendArc does not work with my software?",
    answer:
      "Keep your current mail-handler setup until the beta is verified for your workflow. Submit a sanitized compatibility report and never include private message content, OAuth tokens, or attachments.",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "SendArc",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Windows 10, Windows 11",
  description: SITE_DESCRIPTION,
  url: new URL("/", Astro.site).toString(),
  codeRepository: "https://github.com/KapapiDev/sendarc",
  brand: {
    "@type": "Brand",
    name: "SendArc",
  },
  publisher: {
    "@type": "Organization",
    name: "KaPaPi",
    url: KAPAPI_URL,
  },
};
---

<BaseLayout title="SendArc" path="/" structuredData={structuredData} pageEvent="landing_view">

  <section class="hero" id="overview">
    <div class="shell hero-grid">
      <div class="hero-copy" data-reveal>
        <p class="eyebrow"><a href="/affixa-alternative/">Affixa alternative</a></p>
        <h1>
          <span>Keep your old apps.</span>
          <strong>Use modern email.</strong>
        </h1>
        <p class="hero-lede">
          Send email from legacy Windows applications through Gmail without changing the software your team already depends on.
        </p>
        <div class="hero-actions">
          <DownloadLink />
          <a class="text-link" href="#how-it-works">Learn how it works <Icon name="arrow-down" size={17} /></a>
        </div>
        <ul class="hero-assurances" aria-label="SendArc assurances">
          <li><Icon name="eye" size={17} /> Local preview</li>
          <li><Icon name="shield-check" size={17} /> Secure OAuth</li>
          <li><Icon name="zap" size={17} /> Easy setup</li>
        </ul>
      </div>

      <div class="bridge-visual" role="img" aria-label="Legacy Windows application connects through SendArc to Gmail or Google Workspace" data-reveal>
        <div class="orbit orbit--one"></div>
        <div class="orbit orbit--two"></div>
        <div class="bridge-line bridge-line--left"><i></i><i></i><i></i></div>
        <div class="bridge-line bridge-line--right"><i></i><i></i><i></i></div>
        <div class="bridge-node bridge-node--legacy">
          <span class="node-icon node-icon--window" aria-hidden="true"><i></i><i></i><i></i></span>
          <strong>Legacy Windows app</strong>
          <small>Simple MAPI action</small>
        </div>
        <div class="bridge-node bridge-node--core">
          <span class="arc-mark" aria-hidden="true"><i></i></span>
          <strong>SendArc</strong>
          <small>MAPI bridge</small>
        </div>
        <div class="bridge-node bridge-node--gmail">
          <span class="node-icon node-icon--mail" aria-hidden="true"></span>
          <strong>Gmail</strong>
          <small>Google Workspace</small>
        </div>
      </div>
    </div>
  </section>

  <section class="benefits-band" aria-labelledby="benefits-heading">
    <div class="shell">
      <h2 class="visually-hidden" id="benefits-heading">Key benefits</h2>
      <div class="benefit-grid">
        <article data-reveal>
          <Icon name="grid" size={31} class="line-icon" />
          <h3>No workflow change</h3>
          <p>Keep using the Windows software your team already depends on.</p>
        </article>
        <article data-reveal>
          <Icon name="mail" size={31} class="line-icon" />
          <h3>Use Gmail</h3>
          <p>Send through Gmail or Google Workspace with your existing account.</p>
        </article>
        <article data-reveal>
          <Icon name="shield-check" size={31} class="line-icon" />
          <h3>Secure by design</h3>
          <p>OAuth tokens stay in Windows Credential Manager. No inbox access.</p>
        </article>
        <article data-reveal>
          <Icon name="zap" size={31} class="line-icon" />
          <h3>Focused setup</h3>
          <p>A small Windows utility, not another desktop mail client.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section workflow" id="how-it-works" aria-labelledby="workflow-heading">
    <div class="shell">
      <div class="section-heading section-heading--center" data-reveal>
        <p class="eyebrow">Three clear steps</p>
        <h2 id="workflow-heading">How it works</h2>
        <p>Message content stays on your PC until you explicitly send it to Google.</p>
      </div>
      <ol class="workflow-grid">
        <li data-reveal>
          <span class="step-number">1</span>
          <Icon name="download" size={36} class="step-icon" />
          <h3>Install SendArc</h3>
          <p>Install the Windows beta and let SendArc register as the Simple MAPI handler.</p>
        </li>
        <li data-reveal>
          <span class="step-number">2</span>
          <Icon name="link" size={36} class="step-icon" />
          <h3>Connect Google</h3>
          <p>Sign in to one Gmail or Google Workspace account with the gmail.send permission.</p>
        </li>
        <li data-reveal>
          <span class="step-number">3</span>
          <Icon name="check-circle" size={36} class="step-icon" />
          <h3>Preview, then send</h3>
          <p>Review recipients, subject, body, and attachments locally. Send only when ready.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section why" aria-labelledby="why-heading">
    <div class="shell why-grid">
      <div class="why-copy" data-reveal>
        <p class="eyebrow">Why SendArc</p>
        <h2 id="why-heading">A bridge, not another inbox.</h2>
        <p>
          SendArc keeps a narrow job: help existing line-of-business software hand an outgoing message to Gmail safely.
        </p>
        <ul class="check-list">
          <li><Icon name="check" size={18} />Works with supported Simple MAPI calls</li>
          <li><Icon name="check" size={18} />No new desktop mail client to learn</li>
          <li><Icon name="check" size={18} />Local-first message handling</li>
          <li><Icon name="check" size={18} />Open-source code and inspectable releases</li>
        </ul>
      </div>
      <div class="reason-grid" data-reveal>
        <article><Icon name="app-window" size={27} /><h3>Legacy app friendly</h3><p>Designed for the Windows send actions that older business tools still use.</p></article>
        <article><Icon name="eye" size={27} /><h3>Local preview</h3><p>Review the complete outgoing message before any send request leaves the PC.</p></article>
        <article><Icon name="key" size={27} /><h3>Least privilege</h3><p>The beta asks for gmail.send, not mailbox reading or search access.</p></article>
        <article><Icon name="external-link" size={27} /><h3>Direct to Google</h3><p>No SendArc-operated relay receives your message content.</p></article>
      </div>
    </div>
  </section>

  <section class="section beta" id="business-beta" aria-labelledby="beta-heading">
    <div class="shell beta-grid">
      <div class="beta-copy" data-reveal>
        <p class="eyebrow">Business beta</p>
        <h2 id="beta-heading">Help shape SendArc for teams.</h2>
        <p class="beta-price">Planned business beta: <strong>$29/year per seat.</strong> No charge today.</p>
        <p>
          Tell us how many seats and which Windows workflow you need. The signal helps prioritize compatibility, deployment, and support work without building billing first.
        </p>
        <div class="privacy-note">
          <span aria-hidden="true">i</span>
          <p>Never include email bodies, recipients, OAuth tokens, private attachments, or confidential client data.</p>
        </div>
      </div>
      <div class="beta-panel" data-reveal>
        <BetaForm />
      </div>
    </div>
  </section>

  <section class="section faq-section" id="faq" aria-labelledby="faq-heading">
    <div class="shell faq-shell">
      <div class="section-heading" data-reveal>
        <p class="eyebrow">Straight answers</p>
        <h2 id="faq-heading">Frequently asked questions</h2>
      </div>
      <Faq items={faqItems} />
    </div>
  </section>

  <section class="final-cta">
    <div class="shell final-cta-inner" data-reveal>
      <div>
        <p class="eyebrow">Windows beta</p>
        <h2>Ready to send from the software you already use?</h2>
        <p>Gmail and Google Workspace only. No desktop mail client required.</p>
      </div>
      <DownloadLink />
    </div>
  </section>
</BaseLayout>
