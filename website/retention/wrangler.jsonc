{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sendarc-retention",
  "main": "index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "d1_databases": [{
    "binding": "SENDARC_DB",
    "database_name": "sendarc-leads",
    "database_id": "246981a9-e731-4fc0-ac07-9377ad61c54f",
    "migrations_dir": "../migrations"
  }]
}
